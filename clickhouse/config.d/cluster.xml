<clickhouse>
    <listen_host replace="replace">0.0.0.0</listen_host>

    <zookeeper>
        <node>
            <host>keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <remote_servers>
        <support_cluster>
            <shard>
                <internal_replication>true</internal_replication>

                <replica>
                    <host>clickhouse1</host>
                    <port>9000</port>
                    <user>cluster_internal</user>
                    <password from_env="CLICKHOUSE_CLUSTER_PASSWORD"/>
                </replica>

                <replica>
                    <host>clickhouse2</host>
                    <port>9000</port>
                    <user>cluster_internal</user>
                    <password from_env="CLICKHOUSE_CLUSTER_PASSWORD"/>
                </replica>
            </shard>
        </support_cluster>
    </remote_servers>
</clickhouse>