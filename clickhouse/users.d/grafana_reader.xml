<clickhouse>
    <profiles>
        <grafana_readonly>
            <readonly>1</readonly>

            <constraints>
                <max_execution_time>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </grafana_readonly>
    </profiles>

    <users>
        <grafana_reader>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>
            <networks>
                <ip>0.0.0.0/0</ip>
                <ip>::/0</ip>
            </networks>
            <profile>grafana_readonly</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </grafana_reader>
    </users>
</clickhouse>
