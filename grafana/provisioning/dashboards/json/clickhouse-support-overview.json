                   {
                       "id":  7,
                       "type":  "table",
                       "title":  "Replica Health",
                       "description":  "Cluster-wide replication queue, replication delay, and read-only state for each ClickHouse node.",
                       "datasource":  {
                                          "type":  "grafana-clickhouse-datasource",
                                          "uid":  "clickhouse"
                                      },
                       "gridPos":  {
                                       "h":  7,
                                       "w":  24,
                                       "x":  0,
                                       "y":  12
                                   },
                       "fieldConfig":  {
                                           "defaults":  {

                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "showHeader":  true,
                                       "cellHeight":  "sm"
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "grafana-clickhouse-datasource",
                                                              "uid":  "clickhouse"
                                                          },
                                           "queryType":  "sql",
                                           "rawSql":  "SELECT hostName() AS host, sum(queue_size) AS replication_queue, max(absolute_delay) AS max_delay_seconds, max(is_readonly) AS readonly FROM clusterAllReplicas(\u0027support_cluster\u0027, system.replicas) GROUP BY host ORDER BY host"
                                       }
                                   ]
                   },
                   {
                       "id":  8,
                       "type":  "table",
                       "title":  "Kafka Consumer Health",
                       "description":  "ClickHouse Kafka Engine consumer assignments, offsets, read activity, commit activity, and recent exceptions.",
                       "datasource":  {
                                          "type":  "grafana-clickhouse-datasource",
                                          "uid":  "clickhouse"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  24,
                                       "x":  0,
                                       "y":  19
                                   },
                       "fieldConfig":  {
                                           "defaults":  {

                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "showHeader":  true,
                                       "cellHeight":  "sm"
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "grafana-clickhouse-datasource",
                                                              "uid":  "clickhouse"
                                                          },
                                           "queryType":  "sql",
                                           "rawSql":  "SELECT hostName() AS host, length(assignments.partition_id) AS assigned_partitions, assignments.partition_id AS partitions, assignments.current_offset AS current_offsets, num_messages_read, num_commits, last_poll_time, last_commit_time, is_currently_used, length(exceptions.text) AS recent_exceptions FROM clusterAllReplicas(\u0027support_cluster\u0027, system.kafka_consumers) WHERE database = \u0027saas_analytics\u0027 AND table = \u0027events_kafka\u0027 ORDER BY host"
                                       }
                                   ]
                   },
                   {
                       "id":  9,
                       "type":  "table",
                       "title":  "Recent Expensive Queries",
                       "description":  "Recent completed ClickHouse queries ranked by execution duration, excluding Grafana monitoring queries.",
                       "datasource":  {
                                          "type":  "grafana-clickhouse-datasource",
                                          "uid":  "clickhouse"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  27
                                   },
                       "fieldConfig":  {
                                           "defaults":  {

                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "showHeader":  true,
                                       "cellHeight":  "sm"
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "grafana-clickhouse-datasource",
                                                              "uid":  "clickhouse"
                                                          },
                                           "queryType":  "sql",
                                           "rawSql":  "SELECT hostName() AS host, query_id, query_duration_ms, read_rows, formatReadableSize(read_bytes) AS read_bytes, formatReadableSize(memory_usage) AS memory, left(replaceRegexpAll(query, \u0027\\s+\u0027, \u0027 \u0027), 160) AS query FROM clusterAllReplicas(\u0027support_cluster\u0027, system.query_log) WHERE type = \u0027QueryFinish\u0027 AND event_time \u003e= now() - INTERVAL 2 HOUR AND user != \u0027grafana_reader\u0027 ORDER BY query_duration_ms DESC LIMIT 10"
                                       }
                                   ]
                   }
               ]
